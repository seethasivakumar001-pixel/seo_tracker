# Server Configuration
PORT=3001
NODE_ENV=development

# Database Type Options: sqlite (default), mysql, postgres
DB_TYPE=sqlite

# MySQL Database Configuration (used if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=seo_tracker

# PostgreSQL Database Configuration (used if DB_TYPE=postgres)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=seo_tracker

# Google PageSpeed Insights API Key
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here
