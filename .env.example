# Database Configuration
PORT=3001

# DB_TYPE options: sqlite (default), mysql, postgres
DB_TYPE=mysql

# MySQL Configuration (if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=seo_tracker

# PostgreSQL Configuration (if DB_TYPE=postgres)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=seo_tracker

# Google PageSpeed Insights API Key
VITE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

